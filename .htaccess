# Hostinger Root .htaccess — Auto-route to compiled dist folder
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # Pass through api requests or direct dist requests
  RewriteCond %{REQUEST_URI} ^/api/ [NC,OR]
  RewriteCond %{REQUEST_URI} ^/dist/ [NC]
  RewriteRule ^ - [L]

  # Serve static files from dist directory if they exist
  RewriteCond %{DOCUMENT_ROOT}/dist/$1 -f [OR]
  RewriteCond %{DOCUMENT_ROOT}/dist/$1 -d
  RewriteRule ^(.*)$ dist/$1 [L]

  # SPA fallback to compiled dist/index.html
  RewriteRule ^(.*)$ dist/index.html [L]
</IfModule>

FallbackResource /dist/index.html

<FilesMatch "index\.html$">
  <IfModule mod_headers.c>
    Header set Cache-Control "no-cache, no-store, must-revalidate"
    Header set Pragma "no-cache"
    Header set Expires "0"
  </IfModule>
</FilesMatch>
